+test "httpz: last response before closing announces Connection: Close" {
+    // A reverse proxy (Caddy) reuses a connection whose close was not announced: its next request lands on a
+    // closed socket and becomes a 502 (a POST is never retried).
+    // Blocking mode closes open connections twice on stop (worker.zig): only the non-blocking server runs it.
+    if (comptime blockingMode()) return error.SkipZigTest;
+    var srv = try Server(void).init(t.io, t.allocator, .{ .address = .localhost(6011), .timeout = .{ .request_count = 3 } }, {});
+    defer srv.deinit();
+    var router = try srv.router(.{});
+    router.get("/ping", struct {
+        fn ping(_: *Request, res: *Response) !void {
+            res.body = "ok";
+        }
+    }.ping, .{});
+    const thread = try srv.listenInNewThread();
+    defer {
+        srv.stop();
+        thread.join();
+    }
+    try testing.waitForPort(6011);
+
+    const stream = testStream(6011);
+    defer stream.close(t.io);
+    var writer = stream.writer(t.io, &.{});
+    const w = &writer.interface;
+    var buf: [200]u8 = undefined;
+
+    // Every response before the close keeps the connection; the last one says so before the socket closes.
+    for (0..4) |i| {
+        try w.writeAll("GET /ping HTTP/1.1\r\n\r\n");
+        try w.flush();
+        const got = testReadAll(stream, &buf);
+        if (i > 0 and std.mem.eql(u8, got, "HTTP/1.1 200 \r\nConnection: Close\r\nContent-Length: 2\r\n\r\nok")) return;
+        try t.expectString("HTTP/1.1 200 \r\nContent-Length: 2\r\n\r\nok", got);
+    }
+    return error.ConnectionNeverClosed;
+}
+
