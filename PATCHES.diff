+    try w.writeAll("GET /api/v2/users/2 HTTP/1.1\r\nConnection: close\r\n\r\n");
+    try w.flush();
+    try t.expectString("HTTP/1.1 200 \r\nConnection: Close\r\nContent-Length: 17\r\n\r\nversion=v2,user=2", testReadAll(stream, &buf));
+}
+
+test "httpz: serves on a listener it did not bind and leaves other copies listening" {
+    // systemd keeps a duplicate of the socket across restarts: stopping the server must not end it.
+    // Blocking mode shuts the listener down to unblock accept, which ends every copy: not usable this way.
+    if (comptime blockingMode()) return error.SkipZigTest;
+    const address = try Io.net.IpAddress.parse("127.0.0.1", 6012);
+    var kept = try address.listen(t.io, .{ .reuse_address = true });
+    defer kept.deinit(t.io);
+    const handed = std.c.dup(kept.socket.handle);
+    if (handed < 0) return error.DupFailed;
+
+    var srv = try Server(void).init(t.io, t.allocator, .{ .address = .localhost(6012), .listener = handed }, {});
+    defer srv.deinit();
+    var router = try srv.router(.{});
+    router.get("/ping", struct {
+        fn ping(_: *Request, res: *Response) !void {
+            res.body = "ok";
+        }
+    }.ping, .{});
+    const thread = try srv.listenInNewThread();
+    try testing.waitForPort(6012);
+    {
+        const stream = testStream(6012);
+        defer stream.close(t.io);
+        var writer = stream.writer(t.io, &.{});
+        try writer.interface.writeAll("GET /ping HTTP/1.1\r\n\r\n");
+        try writer.interface.flush();
+        var buf: [100]u8 = undefined;
+        try t.expectString("HTTP/1.1 200 \r\nContent-Length: 2\r\n\r\nok", testReadAll(stream, &buf));
+    }
+    srv.stop();
+    thread.join();
+
+    const late = try address.connect(t.io, .{ .mode = .stream });
+    defer late.close(t.io);
+    const accepted = try kept.accept(t.io);
+    accepted.close(t.io);
+}
+
+test "httpz: gracefulStop finishes requests, closes connections politely and keeps the listener for its other holder" {
+    if (comptime blockingMode()) return error.SkipZigTest;
+    const address = try Io.net.IpAddress.parse("127.0.0.1", 6013);
+    var kept = try address.listen(t.io, .{ .reuse_address = true });
+    defer kept.deinit(t.io);
+    const handed = std.c.dup(kept.socket.handle);
+    if (handed < 0) return error.DupFailed;
+
+    var srv = try Server(void).init(t.io, t.allocator, .{ .address = .localhost(6013), .listener = handed }, {});
+    defer srv.deinit();
+    var router = try srv.router(.{});
+    const Routes = struct {
+        fn ping(_: *Request, res: *Response) !void {
+            res.body = "ok";
+        }
+        fn slow(_: *Request, res: *Response) !void {
+            t.io.sleep(.fromMilliseconds(300), .awake) catch unreachable;
+            res.body = "ok";
+        }
+    };
+    router.get("/ping", Routes.ping, .{});
+    router.get("/slow", Routes.slow, .{});
+    const thread = try srv.listenInNewThread();
+    try testing.waitForPort(6013);
+
+    var buf: [200]u8 = undefined;
+    // Idle keep-alive connection, as a proxy leaves it.
+    const idle = testStream(6013);
+    defer idle.close(t.io);
+    var idle_writer = idle.writer(t.io, &.{});
+    try idle_writer.interface.writeAll("GET /ping HTTP/1.1\r\n\r\n");
+    try idle_writer.interface.flush();
+    try t.expectString("HTTP/1.1 200 \r\nContent-Length: 2\r\n\r\nok", testReadAll(idle, &buf));
+
+    // A request in progress when the drain starts.
+    const busy = try address.connect(t.io, .{ .mode = .stream });
+    defer busy.close(t.io);
+    var busy_writer = busy.writer(t.io, &.{});
+    try busy_writer.interface.writeAll("GET /slow HTTP/1.1\r\n\r\n");
+    try busy_writer.interface.flush();
+    try t.io.sleep(.fromMilliseconds(100), .awake);
+    const started = Io.Clock.awake.now(t.io);
+    srv.gracefulStop(10);
+
+    // The server closes the connection after this answer: read to the end.
+    var len: usize = 0;
+    while (true) {
+        const n = try posix.read(busy.socket.handle, buf[len..]);
+        if (n == 0) break;
+        len += n;
+    }
+    try t.expectString("HTTP/1.1 200 \r\nConnection: Close\r\nContent-Length: 2\r\n\r\nok", buf[0..len]);
+
+    // The idle connection still answers, and says it is the last answer.
+    try idle_writer.interface.writeAll("GET /ping HTTP/1.1\r\n\r\n");
+    try idle_writer.interface.flush();
+    var idle_buf: [200]u8 = undefined;
+    try t.expectString("HTTP/1.1 200 \r\nConnection: Close\r\nContent-Length: 2\r\n\r\nok", testReadAll(idle, &idle_buf));
+
+    // Both connections are closed by the server after their last answer: listen() returns long before the grace.
+    thread.join();
+    try t.expectEqual(true, started.durationTo(Io.Clock.awake.now(t.io)).toMilliseconds() < 3_000);
+
+    // The drained server never accepted again; the other holder still gets the connection.
+    const late = try address.connect(t.io, .{ .mode = .stream });
+    defer late.close(t.io);
+    const accepted = try kept.accept(t.io);
+    accepted.close(t.io);
+}
